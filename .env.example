# ── venus-lite 环境变量示例 ──
# Nuxt runtimeConfig 覆盖约定：
#   runtimeConfig.appVersion        ← NUXT_APP_VERSION（仅服务端可见）
#   runtimeConfig.public.siteName   ← NUXT_PUBLIC_SITE_NAME（客户端可见）
# 规则：NUXT_ 前缀 + 驼峰转大写下划线；public.* 再加 PUBLIC_ 段。
# 开发环境将本文件复制为 .env 后由 `nuxt dev` 自动加载；
# 生产环境通过进程环境变量注入（如 PM2 / node --env-file）。

NUXT_APP_VERSION=0.1.0
NUXT_PUBLIC_SITE_NAME=Venus Lite
