# ── venus-lite 环境变量示例 ──
# Nuxt runtimeConfig 覆盖约定：
#   runtimeConfig.appVersion        ← NUXT_APP_VERSION（仅服务端可见）
#   runtimeConfig.public.siteName   ← NUXT_PUBLIC_SITE_NAME（客户端可见）
# 规则：NUXT_ 前缀 + 驼峰转大写下划线；public.* 再加 PUBLIC_ 段。
# 开发环境将本文件复制为 .env 后由 `nuxt dev` 自动加载；
# 生产环境通过进程环境变量注入（如 PM2 / node --env-file）。

NUXT_APP_VERSION=0.1.0
NUXT_PUBLIC_SITE_NAME=Venus
NUXT_PUBLIC_API_BASE=http://localhost:3000

# OSS / STS（NUXT_OSS_* → runtimeConfig.oss*，仅服务端可见）
NUXT_OSS_REGION="oss-cn-beijing"
NUXT_OSS_BUCKET=""
NUXT_OSS_STS_ROLE_ARN=""
NUXT_OSS_STS_ACCESS_KEY_ID=""
NUXT_OSS_STS_ACCESS_KEY_SECRET=""
NUXT_OSS_STS_SESSION_DURATION_SECONDS=900

# ── Venus Engine 全局配置（NUXT_VENUS_* → runtimeConfig.venus*，仅服务端可见）──
# AI 摄影评估引擎的 LLM 接入配置；BASE_URL + API_KEY + MODEL 三项缺一时
# /api/evaluate* 与 /api/metadata 返回 503 VENUS_DISABLED。
# PROVIDER_TYPE 可选值：openai-chat | openai-responses | anthropic | gemini
NUXT_VENUS_PROVIDER_TYPE="openai-chat"
NUXT_VENUS_PROVIDER_BASE_URL="https://api.openai.com/v1"
NUXT_VENUS_PROVIDER_API_KEY=""
NUXT_VENUS_PROVIDER_MODEL="gpt-4o"
NUXT_VENUS_PROVIDER_TIMEOUT=60000
NUXT_VENUS_MAX_RETRIES=3
# Reasoning（推理/思维链）全局配置
# EFFORT 可选值：none | minimal | low | medium | high | max | xhigh（空字符串 = 不启用）
NUXT_VENUS_REASONING_ENABLED=true
NUXT_VENUS_REASONING_EFFORT=""
NUXT_VENUS_REASONING_BUDGET_TOKENS=0

# ── Venus Engine 每 Agent 独立 Provider 配置 ──
# 每个 Agent 可独立配置 Provider 类型、接入点、密钥、模型、超时、推理参数。
# 未配置（BASE_URL 或 API_KEY 为空）时回落到全局配置。
# Agent 角色：GENRE_DETECTOR | PROPOSER | CRITIC | ARBITER | REVISION

# Genre Detector（门类检测）
NUXT_VENUS_GENRE_DETECTOR_PROVIDER_TYPE=""
NUXT_VENUS_GENRE_DETECTOR_BASE_URL=""
NUXT_VENUS_GENRE_DETECTOR_API_KEY=""
NUXT_VENUS_GENRE_DETECTOR_MODEL=""
NUXT_VENUS_GENRE_DETECTOR_TIMEOUT=0
NUXT_VENUS_GENRE_DETECTOR_REASONING_EFFORT=""
NUXT_VENUS_GENRE_DETECTOR_REASONING_BUDGET_TOKENS=0

# Proposer（提案者初评）
NUXT_VENUS_PROPOSER_PROVIDER_TYPE=""
NUXT_VENUS_PROPOSER_BASE_URL=""
NUXT_VENUS_PROPOSER_API_KEY=""
NUXT_VENUS_PROPOSER_MODEL=""
NUXT_VENUS_PROPOSER_TIMEOUT=0
NUXT_VENUS_PROPOSER_REASONING_EFFORT=""
NUXT_VENUS_PROPOSER_REASONING_BUDGET_TOKENS=0

# Critic（批判者攻击）
NUXT_VENUS_CRITIC_PROVIDER_TYPE=""
NUXT_VENUS_CRITIC_BASE_URL=""
NUXT_VENUS_CRITIC_API_KEY=""
NUXT_VENUS_CRITIC_MODEL=""
NUXT_VENUS_CRITIC_TIMEOUT=0
NUXT_VENUS_CRITIC_REASONING_EFFORT=""
NUXT_VENUS_CRITIC_REASONING_BUDGET_TOKENS=0

# Arbiter（仲裁者裁决）
NUXT_VENUS_ARBITER_PROVIDER_TYPE=""
NUXT_VENUS_ARBITER_BASE_URL=""
NUXT_VENUS_ARBITER_API_KEY=""
NUXT_VENUS_ARBITER_MODEL=""
NUXT_VENUS_ARBITER_TIMEOUT=0
NUXT_VENUS_ARBITER_REASONING_EFFORT=""
NUXT_VENUS_ARBITER_REASONING_BUDGET_TOKENS=0

# Revision（修正轮，默认沿用 Proposer 配置）
NUXT_VENUS_REVISION_PROVIDER_TYPE=""
NUXT_VENUS_REVISION_BASE_URL=""
NUXT_VENUS_REVISION_API_KEY=""
NUXT_VENUS_REVISION_MODEL=""
NUXT_VENUS_REVISION_TIMEOUT=0
NUXT_VENUS_REVISION_REASONING_EFFORT=""
NUXT_VENUS_REVISION_REASONING_BUDGET_TOKENS=0
